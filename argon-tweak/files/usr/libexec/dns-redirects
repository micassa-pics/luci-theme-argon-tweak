#!/bin/sh

set -eu
umask 077
ram=/tmp/dns-redirects
history=/etc/dns-redirects/history.tsv

snapshot() {
	local cutoff=
	if [ -r "$ram/cleared-at" ]; then
		read -r cutoff < "$ram/cleared-at"
	fi
	{
		if [ -z "$cutoff" ]; then
			if [ -r "$ram/previous.tsv" ]; then
				cat "$ram/previous.tsv"
			elif [ -r "$history" ]; then
				cat "$history"
			fi
		fi
		for log in "$ram/events.old" "$ram/events"; do
			[ ! -r "$log" ] || cat "$log"
		done
	} | awk -v cutoff="$cutoff" '
		function ipv4(ip, octets, i) {
			if (split(ip, octets, /[.]/) != 4) return 0
			for (i = 1; i <= 4; i++)
				if (octets[i] !~ /^[0-9]+$/ || length(octets[i]) > 3 || octets[i] > 255) return 0
			return 1
		}
		function address(ip) {
			return ipv4(ip) || (ip ~ /:/ && length(ip) <= 45 && ip ~ /^[0-9a-fA-F:.]+$/)
		}
		BEGIN { OFS = "\t" }
		/^[0-9]+\.[0-9]+\t/ {
			if ((NF == 4 || NF == 5) && address($2) && address($3) && $4 ~ /^(TCP|UDP)$/) {
				action = (NF == 4 ? "unrecorded" : $5)
				if (action ~ /^(pihole|blocked|unrecorded)$/) print $1, $2, $3, $4, action
			}
			next
		}
		$6 ~ /^\[[0-9]+\.[0-9]+\]$/ && $7 ~ /^kern[.]/ && $8 == "kernel:" {
			if (cutoff != "") {
				if (!match($0, / kernel: \[[[:space:]]*[0-9]+\.[0-9]+\]/)) next
				stamp = substr($0, RSTART, RLENGTH)
				gsub(/[^0-9.]/, "", stamp)
				# /proc/uptime is precise to a hundredth of a second.
				if (stamp + 0 < cutoff + 0.01) next
			}
			if (!match($0, / kernel: (\[[^]]*\][[:space:]]*)?argon-tweak-dns-(redirect|block): /)) next
			action = (substr($0, RSTART, RLENGTH) ~ /-block: $/ ? "blocked" : "pihole")
			split(substr($0, RSTART + RLENGTH), fields, / +/)
			client = server = proto = port = ""
			for (i in fields) {
				if (fields[i] ~ /^SRC=/) client = substr(fields[i], 5)
				if (fields[i] ~ /^DST=/) server = substr(fields[i], 5)
				if (fields[i] ~ /^PROTO=/) proto = substr(fields[i], 7)
				if (fields[i] ~ /^DPT=/) port = substr(fields[i], 5)
			}
			if (address(client) && address(server) && proto ~ /^(TCP|UDP)$/ && (port == 53 || (action == "blocked" && port == 853)))
				print substr($6, 2, length($6)-2), client, server, proto, action
		}
	' | tail -n 1000
}

checkpoint() (
	local pending staged=
	[ -d "$ram" ] || return 0
	lock "$ram/checkpoint.lock" || return 1
	pending=
	trap '[ -z "$pending" ] || rm -f "$pending"; [ -z "$staged" ] || rm -f "$staged"; lock -u "$ram/checkpoint.lock"' EXIT
	pending=$(mktemp "$ram/checkpoint.XXXXXX") || return 1
	snapshot > "$pending" || return 1
	[ -s "$pending" ] || return 0
	if [ -f "$history" ] && cmp -s "$pending" "$history"; then
		return 0
	fi
	mkdir -p "${history%/*}" || return 1
	staged=$(mktemp "$history.XXXXXX") || return 1
	cp "$pending" "$staged" || return 1
	mv -f "$staged" "$history" || return 1
	sync
)

clear_history() (
	local cutoff pending=
	[ -d "$ram" ] || return 1
	lock "$ram/checkpoint.lock" || return 1
	trap '[ -z "$pending" ] || rm -f "$pending"; lock -u "$ram/checkpoint.lock"' EXIT
	read -r cutoff _ < /proc/uptime || return 1
	pending=$(mktemp "$ram/cleared-at.XXXXXX") || return 1
	printf '%s\n' "$cutoff" > "$pending" || return 1
	rm -f "$history" || return 1
	mv -f "$pending" "$ram/cleared-at" || return 1
	sync
)

case "${1:-}" in
	snapshot) snapshot ;;
	clear) clear_history ;;
	checkpoint-loop)
		trap 'kill "$sleeper" 2>/dev/null || :; exit 0' TERM INT
		while :; do
			sleep 1800 &
			sleeper=$!
			wait "$sleeper"
			if ! checkpoint; then
				echo 'DNS Redirects could not save history' >&2
			fi
		done
		;;
	checkpoint) checkpoint ;;
	*) exit 2 ;;
esac
