#!/bin/sh /etc/rc.common

START=18
STOP=85
USE_PROCD=1

shutdown() {
	/usr/libexec/dns-redirects checkpoint || logger -t dns-redirects 'Could not save history at shutdown'
	stop
}

start_service() {
	local ram=/tmp/dns-redirects
	umask 077
	mkdir -p "$ram" || return 1
	if [ ! -f "$ram/previous.tsv" ]; then
		if [ -r /etc/dns-redirects/history.tsv ]; then
			cp /etc/dns-redirects/history.tsv "$ram/previous.tsv" || return 1
		else
			: > "$ram/previous.tsv" || return 1
		fi
	fi

	procd_open_instance collector
	procd_set_param command /sbin/logread -f -t -z 0 -e 'MICASSA_DNS_REDIRECT: ' -S 512 -F "$ram/events"
	procd_set_param respawn 3600 5 0
	procd_close_instance

	procd_open_instance checkpoint
	procd_set_param command /usr/libexec/dns-redirects checkpoint-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}
